# NEXO AI — Environment Variables
# Copy this file to .env.local for local development.
# On Vercel: Project Settings → Environment Variables → add each key below.

# ── OpenRouter ────────────────────────────────────────────────────────────────
# All NEXO AI models run through OpenRouter.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Supabase ──────────────────────────────────────────────────────────────────
# Used for chat history, messages, and auth.
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── GitHub (optional — Nexo Coder feature) ────────────────────────────────────
# Only needed if GitHub repo push/pull features are enabled.
GITHUB_MODELS_TOKEN=your_github_token_here
